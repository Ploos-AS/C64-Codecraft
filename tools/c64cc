#!/bin/sh
# Internal repository/CI helper. This is not a student-facing build framework.
set -eu

cmd="${1:-help}"

case "$cmd" in
  doctor)
    echo "C64 Codecraft toolchain diagnostics"
    for tool in 64tass acme ca65 x64sc java python3; do
      if command -v "$tool" >/dev/null 2>&1; then
        printf 'OK   %s\n' "$tool"
      else
        printf 'MISS %s\n' "$tool"
      fi
    done
    ;;
  help|-h|--help)
    cat <<'EOF'
c64cc - internal C64 Codecraft repository diagnostics

Commands:
  doctor    inspect tools used by CI/course qualification
  help      show this help

Students use the real assemblers, VICE and scene tools directly.
EOF
    ;;
  *)
    echo "c64cc: unknown internal command: $cmd" >&2
    exit 2
    ;;
esac
